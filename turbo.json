{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "biome.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typegen": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "start:debug": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test:unit": {
      "dependsOn": [
        "typegen",
        "^build"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": [
        "typegen",
        "^build"
      ],
      "outputs": [],
      "cache": false
    },
    "types:check": {
      "dependsOn": [
        "typegen",
        "^build"
      ],
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "migrate:deploy": {
      "cache": false,
      "outputs": []
    },
    "migrate:rollback": {
      "cache": false,
      "outputs": []
    },
    "seed": {
      "cache": false,
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "POSTGRES_USER",
    "POSTGRES_PASSWORD",
    "POSTGRES_DB",
    "DATABASE_URL",
    "DB_HOST",
    "DB_PORT",
    "DB_SCHEMA",
    "REDIS_HOST",
    "REDIS_PORT",
    "GOLEMIO_API_KEY",
    "TRANSIT_LAND_API_KEY"
  ]
}
